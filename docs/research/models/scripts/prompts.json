{
 "fewshot": [
  ["list all files in the current directory, including hidden ones", "ls -a"],
  ["count the number of lines in notes.txt", "wc -l notes.txt"],
  ["copy the file a.txt into the backup directory", "cp a.txt backup/"],
  ["show the first 5 lines of main.py", "head -n 5 main.py"]
 ],
 "tasks": [
  {"id": 1, "task": "find all Python files under the src directory, recursively", "ref": "find src -name '*.py'", "ok": ["^find\\s+(\\./)?src/?\\b.*-i?name\\s+['\"]?\\*\\.py", "^(ls|ls -R).*src.*\\.py", "^fd .*py.*src"]},
  {"id": 2, "task": "show the last 20 lines of server.log", "ref": "tail -n 20 server.log", "ok": ["^tail\\s+(-n\\s*20|-20|--lines=20)\\s+server\\.log"]},
  {"id": 3, "task": "search recursively for the string TODO in the src directory and show line numbers", "ref": "grep -rn 'TODO' src", "ok": ["^grep\\s+(-[a-zA-Z]*r[a-zA-Z]*n[a-zA-Z]*|-[a-zA-Z]*n[a-zA-Z]*r[a-zA-Z]*|-r\\s+-n|-n\\s+-r|-[rR]n|-n[rR])\\s+['\"]?TODO['\"]?\\s+(\\./)?src", "^rg\\s+(-n\\s+)?['\"]?TODO['\"]?\\s+src"]},
  {"id": 4, "task": "replace every occurrence of foo with bar in config.ini, editing the file in place", "ref": "sed -i 's/foo/bar/g' config.ini", "ok": ["^sed\\s+-i\\S*\\s+['\"]s/foo/bar/g['\"]\\s+config\\.ini", "^perl\\s+-pi\\S*\\s+-e\\s+['\"]s/foo/bar/g['\"]\\s+config\\.ini"]},
  {"id": 5, "task": "run the tests in tests/test_math.py with pytest and stop at the first failure", "ref": "pytest -x tests/test_math.py", "ok": ["^(python3? -m )?pytest\\s+.*(-x|--exitfirst|--maxfail=1).*tests/test_math\\.py|^(python3? -m )?pytest\\s+tests/test_math\\.py\\s+.*(-x|--exitfirst|--maxfail=1)"]},
  {"id": 6, "task": "make the script deploy.sh executable", "ref": "chmod +x deploy.sh", "ok": ["^chmod\\s+(\\+x|u\\+x|a\\+x|755|0755|775|744)\\s+(\\./)?deploy\\.sh"]},
  {"id": 7, "task": "create the directory build/output, including any missing parent directories", "ref": "mkdir -p build/output", "ok": ["^mkdir\\s+(-p|--parents)\\s+(\\./)?build/output/?$"]},
  {"id": 8, "task": "show the changes in the working tree that are not yet staged in git", "ref": "git diff", "ok": ["^git\\s+diff\\s*$", "^git\\s+diff\\s+(--\\s*)?$"]},
  {"id": 9, "task": "stage all changes and commit them with the message \"fix parser bug\"", "ref": "git add -A && git commit -m \"fix parser bug\"", "ok": ["^git\\s+add\\s+(-A|--all|\\.)\\s*(&&|;)\\s*git\\s+commit\\s+-m\\s+['\"]fix parser bug['\"]", "^git\\s+commit\\s+-a?m\\s+['\"]fix parser bug['\"]|^git\\s+commit\\s+-a\\s+-m\\s+['\"]fix parser bug['\"]"]},
  {"id": 10, "task": "print the third column of the comma-separated file data.csv", "ref": "cut -d, -f3 data.csv", "ok": ["^cut\\s+(-d\\s*['\"]?,['\"]?\\s+-f\\s*3|-f\\s*3\\s+-d\\s*['\"]?,['\"]?)\\s+data\\.csv", "^awk\\s+(-F\\s*['\"]?,['\"]?|-F,)\\s+['\"]\\{\\s*print \\$3\\s*;?\\s*\\}['\"]\\s+data\\.csv"]},
  {"id": 11, "task": "count the number of unique lines in names.txt", "ref": "sort -u names.txt | wc -l", "ok": ["^sort\\s+(-u\\s+)?names\\.txt\\s*\\|\\s*(uniq\\s*\\|\\s*)?wc\\s+-l$", "^sort\\s+-u\\s+names\\.txt\\s*\\|\\s*wc\\s+-l", "^cat names\\.txt\\s*\\|\\s*sort\\s*(-u\\s*)?\\|\\s*(uniq\\s*\\|\\s*)?wc\\s+-l"]},
  {"id": 12, "task": "find files larger than 100 megabytes under /var/log", "ref": "find /var/log -size +100M", "ok": ["^find\\s+/var/log/?\\s+.*-size\\s+\\+100M"]},
  {"id": 13, "task": "show the disk usage of each subdirectory of the current directory in human-readable form", "ref": "du -sh */", "ok": ["^du\\s+(-sh|-hs|-h\\s+-s|-s\\s+-h)\\s+(\\./)?\\*/?", "^du\\s+-h\\s+(--max-depth=1|-d\\s*1)", "^du\\s+(--max-depth=1|-d\\s*1)\\s+-h"]},
  {"id": 14, "task": "extract the gzip-compressed tar archive release.tar.gz", "ref": "tar -xzf release.tar.gz", "ok": ["^tar\\s+-?(xzf|xvzf|zxf|zxvf|xf|xvf|xzvf)\\s+release\\.tar\\.gz"]},
  {"id": 15, "task": "delete all .pyc files in the current directory and its subdirectories", "ref": "find . -name '*.pyc' -delete", "ok": ["^find\\s+\\.\\s+.*-i?name\\s+['\"]?\\*\\.pyc['\"]?.*(-delete|-exec\\s+rm|\\|\\s*xargs\\s+rm)"]},
  {"id": 16, "task": "run make and write both its standard output and standard error to build.log", "ref": "make > build.log 2>&1", "ok": ["^make\\s*(>\\s*build\\.log\\s+2>&1|&>\\s*build\\.log|2>&1\\s*\\|\\s*tee\\s+build\\.log|>&\\s*build\\.log)"]},
  {"id": 17, "task": "show which process is listening on TCP port 8080", "ref": "lsof -i :8080", "ok": ["^(sudo\\s+)?lsof\\s+-i\\s*(tcp)?:8080", "^(sudo\\s+)?(ss|netstat)\\s+-\\S*l\\S*.*8080", "^(sudo\\s+)?fuser\\s+8080/tcp"]},
  {"id": 18, "task": "download the file at https://example.com/data.zip into the current directory", "ref": "curl -O https://example.com/data.zip", "ok": ["^curl\\s+(-[a-zA-Z]*O[a-zA-Z]*|-L\\s+-O|-O\\s+-L)\\s+['\"]?https://example\\.com/data\\.zip", "^wget\\s+(-q\\s+)?['\"]?https://example\\.com/data\\.zip", "^curl\\s+.*-o\\s+data\\.zip\\s+.*https://example\\.com/data\\.zip|^curl\\s+.*https://example\\.com/data\\.zip\\s+.*-o\\s+data\\.zip"]},
  {"id": 19, "task": "print the value of the PATH environment variable", "ref": "echo $PATH", "ok": ["^echo\\s+['\"]?\\$\\{?PATH\\}?['\"]?$", "^printenv\\s+PATH$", "^printf\\s+.*\\$\\{?PATH"]},
  {"id": 20, "task": "show the 10 most recently modified files in the current directory", "ref": "ls -t | head -n 10", "ok": ["^ls\\s+-[a-zA-Z]*t[a-zA-Z]*\\s*\\|\\s*head(\\s+-n\\s*10|\\s+-10)?$"]}
 ]
}
