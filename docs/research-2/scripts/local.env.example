# Copy to local.env (gitignored) and adjust for this machine.
# PY: a Python 3.12 venv with vllm==0.34.0 (brings torch 2.14.0+cu130, transformers 5.22.2).
#   uv venv -p 3.12 .venv && uv pip install --python .venv vllm==0.34.0 trl==1.18.1
PY=.venv/bin/python
# Throwaway dir for sandbox work dirs (one per action, deleted after use).
SANDBOX_TMP=/tmp
# Fraction of GPU memory vLLM may take (16 GB card, desktop holds about 2.5 GB).
GPU_UTIL=0.55
