# Machine-specific settings. Copy to local.env (gitignored) and adjust.
# Every stage reads this file through common/env.py; nothing else holds absolute paths.

# Where downloaded corpora, packed token files and checkpoints go (large).
DATA_DIR=data/cache
CKPT_DIR=checkpoints
# Throwaway dirs for sandbox episodes (one per episode, deleted after use). A local disk, not tmpfs:
# on tmpfs (/tmp here) files the model writes would sit in RAM. Relative paths are relative to the repo.
# Must support atime updates (relatime is fine, noatime is not): the forbidden-read detector needs them.
SANDBOX_TMP=data/cache/sandbox
# Fraction of GPU memory vLLM may take (16 GB card, the desktop holds about 2 GB).
GPU_UTIL=0.55
# Hugging Face cache (leave empty for the default ~/.cache/huggingface).
HF_HOME=
# Story corpora: output dirs of nanoalignment-stories (stories.jsonl + manifest.json), one per run.
# Configs name a run dir relative to this (configs/data/*.yaml: stories.dir).
STORIES_DIR=data/cache/stories
# Checkout of GrimsVerk/nanoalignment-stories (the generator), used only by `make smoke-stories`.
STORIES_REPO=../nanoalignment-stories
