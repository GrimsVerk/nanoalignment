# Machine-specific settings. Copy to local.env (gitignored) and adjust.
# Every stage reads this file through common/env.py; nothing else holds absolute paths.

# Where downloaded corpora, packed token files and checkpoints go (large).
DATA_DIR=data/cache
CKPT_DIR=checkpoints
# Throwaway dirs for sandbox episodes (one per episode, deleted after use). A fast local disk.
# Must support atime updates (relatime is fine, noatime is not): the forbidden-read detector needs them.
SANDBOX_TMP=/tmp
# Fraction of GPU memory vLLM may take (16 GB card, the desktop holds about 2 GB).
GPU_UTIL=0.55
# Hugging Face cache (leave empty for the default ~/.cache/huggingface).
HF_HOME=
